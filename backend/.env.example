# Copiar a backend/.env (no se versiona) y ajustar valores.
PORT=3001

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qcs_lacteos

# Orígenes permitidos por CORS (separados por coma). el frontend corre en 3000.
CORS_ORIGIN=http://localhost:3000

# Secreto HS256 para firmar/verificar JWT. Usar un valor largo y aleatorio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
